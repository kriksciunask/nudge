# Data: never commit (small samples in data/sample/ are the exception)
data/raw/
*.csv
*.parquet
*.zip
*.gz
!data/sample/**

# Python / tools
.venv/
__pycache__/
.ipynb_checkpoints/
.DS_Store
.omc/

# Keep the trained model
!app/model.pt

# Lecturer course materials (copied locally for reference, not ours to publish)
course/

# Secrets (API keys)
.env
!app/shop/*.csv
!app/shop/custom/*.csv
!results/*.csv
!results/tuning/
!results/tuning/*.csv

# Streamlit secrets (presenter key); only the .example file is committed
.streamlit/secrets.toml
