# Copy to .streamlit/secrets.toml for local runs (that file is git-ignored).
# On Streamlit Community Cloud paste the same lines into: app menu > Settings > Secrets.

# Presenter key for the live audience board: open  <app url>/?board=1&key=<this value>
# Required for the presenter menu, reset, hide and demo: without it all of them are off (there is no fallback key).
board_key = "choose-a-long-random-word"

# Optional: the address the QR code points to. Normally not needed, the app uses its own address.
# join_url = "https://your-app.streamlit.app"
